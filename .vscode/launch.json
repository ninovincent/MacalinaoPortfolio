{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open Portfolio",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "C:\\Windows\\System32\\cmd.exe",
      "runtimeArgs": [
        "/d",
        "/c",
        "${workspaceFolder}\\.vscode\\open-portfolio.cmd"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": false,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Open Portfolio in Chrome",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html",
      "preLaunchTask": "Copy portfolio images"
    },
    {
      "name": "Open Portfolio in Edge",
      "type": "msedge",
      "request": "launch",
      "file": "${workspaceFolder}/index.html",
      "preLaunchTask": "Copy portfolio images"
    }
  ]
}
